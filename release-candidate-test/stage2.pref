Pin: version 0.4.3+ptos3-245
Pin-Priority: 500

Package: python3-nmcli
Pin: version 1.3.0+ptos3-245
Pin-Priority: 500

Package: python3-click-logging
Pin: version 1.0.1+ptos3-245
Pin-Priority: 500

Package: python3-dbus-fast
Pin: version 0:2.44.3-2~w2d0
Pin-Priority: 500

Package: python3-bluez-peripheral
